# ── Language model (pick one; the first key found is used) ───────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Optional overrides. Defaults per provider:
#   anthropic → claude-sonnet-5-5 / claude-haiku-5-5
#   openai    → gpt-5.4 / gpt-5.4-mini
#   gemini    → gemini-3.5-flash / gemini-3.5-flash-lite
# LLM_PROVIDER=anthropic        # anthropic | openai | gemini | openrouter | ollama | custom
# LLM_MODEL=                    # writer model (plan, findings, review, podcast)
# LLM_FAST_MODEL=               # screening, evidence cards, audit, live voice tools
# LLM_BASE_URL=                 # any OpenAI-compatible endpoint (custom / ollama)
# LLM_API_KEY=

# Dense embeddings for hybrid retrieval (auto-uses OPENAI or GEMINI key if present; BM25 always on)
# EMBEDDINGS_PROVIDER=auto      # auto | openai | gemini | custom | off

# ── ElevenLabs (voice debate + audio overview) ───────────────────────────────
ELEVENLABS_API_KEY=
# The studio creates its own agent with the right prompt and client tools.
# Set this only to use an agent you configured yourself.
# ELEVENLABS_AGENT_ID=
# ELEVENLABS_AGENT_LLM=gemini-2.5-flash
# ELEVENLABS_AGENT_VOICE_ID=
# PODCAST_VOICE_MIRA=EXAVITQu4vr4xnSDxMaL
# PODCAST_VOICE_THEO=JBFqnCBsd6RMkjVDRZzb
# PODCAST_TTS_MODEL=eleven_multilingual_v2

# ── Scholarly sources (all work without keys; keys raise rate limits) ────────
# Free OpenAlex key: https://openalex.org/  (no key = small daily budget)
OPENALEX_API_KEY=
SEMANTIC_SCHOLAR_API_KEY=
# Sent to OpenAlex as a courtesy contact
CONTACT_EMAIL=

# ── Wiring (defaults suit `npm start` + n8n on localhost; docker-compose overrides these) ──
# ENGINE=auto                    # auto | n8n | local  (local = built-in runner, no n8n needed)
# N8N_URL=http://localhost:5678
# STUDIO_CALLBACK_URL=http://localhost:3000   # where n8n posts progress back
# PORT=3000
# Shared secret so only the studio can trigger the n8n webhooks (set for both services)
MARGINALIA_WEBHOOK_TOKEN=
